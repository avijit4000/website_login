SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true

# Flask Google OAuth settings. Create these in Google Cloud Console.
# Authorized redirect URI: http://localhost:5000/auth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth